{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/dev-sessions/v1/device-endpoint.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate_sha256",
    "daemon_url"
  ],
  "properties": {
    "certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "daemon_url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 9,
          "maxLength": 512,
          "pattern": "^https://[^/?#@\\s]+/?$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
