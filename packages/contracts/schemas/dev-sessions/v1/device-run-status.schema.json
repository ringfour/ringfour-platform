{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/dev-sessions/v1/device-run-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "exit_code",
    "error"
  ],
  "properties": {
    "state": {
      "enum": [
        "queued",
        "preparing",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
