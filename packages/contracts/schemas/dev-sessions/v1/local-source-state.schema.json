{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/dev-sessions/v1/local-source-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation",
    "paths",
    "archive_sha256"
  ],
  "properties": {
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "paths": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      }
    },
    "archive_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
