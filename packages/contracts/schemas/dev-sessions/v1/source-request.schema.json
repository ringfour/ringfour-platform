{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/dev-sessions/v1/source-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_generation",
    "archive_sha256",
    "archive_size",
    "archive_base64",
    "manifest"
  ],
  "properties": {
    "base_generation": {
      "type": "integer",
      "minimum": 0
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "archive_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1398104,
      "contentEncoding": "base64",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoint",
        "python_requirement",
        "lock_sha256",
        "files",
        "deleted_paths"
      ],
      "properties": {
        "entrypoint": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "python_requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "deleted_paths": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
          }
        }
      }
    }
  }
}
