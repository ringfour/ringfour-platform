{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/logbook/v2/device-event.schema.json",
  "title": "Device mission Logbook event with artifact evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "robot_id", "local_sequence", "occurred_at", "type", "schema_version", "operation_id", "execution_id", "payload"],
  "properties": {
    "event_id": {"$ref": "#/$defs/uuid"},
    "robot_id": {"$ref": "#/$defs/uuid"},
    "local_sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "type": {"const": "mission.logbook.entry"},
    "schema_version": {"const": 2},
    "operation_id": {"$ref": "#/$defs/uuid"},
    "execution_id": {"$ref": "#/$defs/uuid"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "message", "fields", "evidence"],
      "properties": {
        "level": {"const": "info"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S", "not": {"pattern": "\\u0000"}},
        "fields": {"type": "object", "maxProperties": 16, "propertyNames": {"pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"}, "additionalProperties": {"anyOf": [{"type": "string", "maxLength": 512}, {"type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991}, {"type": "boolean"}, {"type": "null"}]}},
        "evidence": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}
      }
    }
  },
  "$defs": {"uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}
}
