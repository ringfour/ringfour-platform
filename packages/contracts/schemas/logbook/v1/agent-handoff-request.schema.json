{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/logbook/v1/agent-handoff-request.schema.json",
  "title": "Agent motion handoff request, new design",
  "oneOf": [
    {"type":"object", "additionalProperties":false, "required":["method","stream_id","after","limit"],
     "properties":{"method":{"const":"read"},"stream_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/uuid"}]},"after":{"$ref":"#/$defs/cursor"},"limit":{"type":"integer","minimum":1,"maximum":100}}},
    {"type":"object", "additionalProperties":false, "required":["method","stream_id","sequence"],
     "properties":{"method":{"const":"acknowledge"},"stream_id":{"$ref":"#/$defs/uuid"},"sequence":{"$ref":"#/$defs/cursor"}}}
  ],
  "$defs": {
    "cursor":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  }
}
