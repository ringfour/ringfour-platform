{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/logbook/v1/runtime-entry-request.schema.json",
  "title": "Proposed mission-authored Logbook entry",
  "description": "New Ringfour runtime design; trusted execution context is attached by the runtime, not supplied in this request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id",
    "level",
    "message",
    "fields"
  ],
  "properties": {
    "entry_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "level": {
      "const": "info"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S",
      "not": {
        "pattern": "\\u0000"
      }
    },
    "fields": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 512,
            "not": {
              "pattern": "\\u0000"
            }
          },
          {
            "type": "number",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  }
}
