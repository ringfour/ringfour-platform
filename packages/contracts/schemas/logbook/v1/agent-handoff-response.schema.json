{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/logbook/v1/agent-handoff-response.schema.json",
  "title": "Agent motion handoff response, new design",
  "oneOf": [
    {"type":"object","additionalProperties":false,"required":["ok","result"],
     "properties":{"ok":{"const":true},"result":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/page"}]}}},
    {"type":"object","additionalProperties":false,"required":["ok","error"],
     "properties":{"ok":{"const":false},"error":{"enum":["history_gap","invalid_request","journal_unavailable"]}}}
  ],
  "$defs": {
    "cursor":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "page":{"type":"object","additionalProperties":false,"required":["stream_id","acknowledged_sequence","last_sequence","events"],
      "properties":{"stream_id":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "acknowledged_sequence":{"$ref":"#/$defs/cursor"},"last_sequence":{"$ref":"#/$defs/cursor"},
        "events":{"type":"array","maxItems":100,"items":{"$ref":"https://contracts.ringfour.dev/logbook/v1/agent-motion-event.schema.json"}}}}
  }
}
