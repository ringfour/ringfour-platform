{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/logbook/v1/device-event.schema.json",
  "title": "Device Logbook event",
  "description": "New Ringfour design; authenticated robot authority and execution attribution are verified by the Platform.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "robot_id",
    "local_sequence",
    "occurred_at",
    "type",
    "schema_version",
    "operation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "$ref": "#/$defs/uuid"
    },
    "robot_id": {
      "$ref": "#/$defs/uuid"
    },
    "local_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "type": {
      "enum": [
        "device.operation.state_changed",
        "mission.logbook.entry",
        "agent.motion.event"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    },
    "execution_id": {
      "$ref": "#/$defs/uuid"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "device.operation.state_changed"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "execution_id"
          ],
          "properties": {
            "execution_id": {}
          }
        },
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state"
            ],
            "properties": {
              "state": {
                "enum": [
                  "accepted",
                  "running",
                  "succeeded",
                  "failed",
                  "cancelled"
                ]
              }
            }
          },
          "operation_id": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "mission.logbook.entry"
          }
        }
      },
      "then": {
        "required": [
          "execution_id"
        ],
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "message",
              "fields"
            ],
            "properties": {
              "level": {
                "const": "info"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S",
                "not": {
                  "pattern": "\\u0000"
                }
              },
              "fields": {
                "type": "object",
                "maxProperties": 16,
                "propertyNames": {
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 512,
                      "not": {
                        "pattern": "\\u0000"
                      }
                    },
                    {
                      "type": "number",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "execution_id": {
            "$ref": "#/$defs/uuid"
          },
          "operation_id": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.motion.event"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "execution_id"
          ]
        },
        "properties": {
          "operation_id": {
            "type": "null"
          },
          "payload": {
            "$ref": "https://contracts.ringfour.dev/logbook/v1/agent-motion-event.schema.json"
          }
        }
      }
    }
  ]
}
