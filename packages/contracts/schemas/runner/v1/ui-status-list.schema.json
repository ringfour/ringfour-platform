{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/runner/v1/ui-status-list.schema.json",
  "title": "Runner active mission UI status list",
  "type": "object",
  "required": ["executions"],
  "additionalProperties": false,
  "properties": {
    "executions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["execution_id", "state"],
        "additionalProperties": false,
        "properties": {
          "execution_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "state": { "enum": ["starting", "ready", "unavailable", "ended"] }
        }
      }
    }
  }
}
