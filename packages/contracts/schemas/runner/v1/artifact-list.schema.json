{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/runner/v1/artifact-list.schema.json",
  "title": "Execution artifact list",
  "type": "object",
  "additionalProperties": false,
  "required": ["execution_id", "artifacts"],
  "properties": {
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "artifact_state": {"enum": ["unknown", "pending", "uploading", "ready", "failed"]},
    "artifact_error": {"type": ["object", "null"], "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "maxLength": 100}, "message": {"type": "string", "maxLength": 500}}},
    "artifacts": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "path": {"type": "string", "minLength": 1, "maxLength": 240},
          "size": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "content_type": {"enum": ["image/jpeg", "image/png", "application/octet-stream"]},
          "state": {"enum": ["pending", "uploading", "available", "failed"]}
        }
      }
    }
  }
}
