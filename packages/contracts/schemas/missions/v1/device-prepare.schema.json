{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/missions/v1/device-prepare.schema.json",
  "title": "Device mission preparation command payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deployment_id",
    "mission_revision_id",
    "revision_id",
    "archive_sha256",
    "archive_size",
    "revision_digest",
    "entrypoint",
    "python_requirement",
    "lock_sha256",
    "retain_digests"
  ],
  "properties": {
    "deployment_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "mission_revision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "entrypoint": {
      "type": "string",
      "minLength": 4,
      "maxLength": 240
    },
    "python_requirement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "retain_digests": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
