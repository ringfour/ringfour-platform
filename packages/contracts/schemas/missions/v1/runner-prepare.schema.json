{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/missions/v1/runner-prepare.schema.json",
  "title": "Prepare an immutable mission revision in Runner",
  "type": "object", "additionalProperties": false,
  "required": ["revision_digest", "code_ref", "entrypoint", "python_requirement", "lock_sha256", "retain_digests"],
  "properties": {
    "revision_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "entrypoint": {"type": "string", "minLength": 4, "maxLength": 240},
    "python_requirement": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "retain_digests": {"type": "array", "maxItems": 2, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
