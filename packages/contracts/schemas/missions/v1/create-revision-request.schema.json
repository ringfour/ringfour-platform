{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/missions/v1/create-revision-request.schema.json",
  "title": "Publish an immutable mission revision",
  "type": "object", "additionalProperties": false,
  "required": ["script_revision_id", "expected_version", "manifest"],
  "properties": {
    "script_revision_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "expected_version": {"type": "integer", "minimum": 0},
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "name", "entrypoint", "python_requirement", "lock_file", "source_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
        "entrypoint": {"type": "string", "minLength": 4, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*\\.py$"},
        "python_requirement": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
        "lock_file": {"const": "requirements.lock"},
        "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "robot_profile_ref": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S"}
      }
    }
  }
}
