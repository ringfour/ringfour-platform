{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/pairing/v1/create-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "code_hash",
    "credential_hash"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "code_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "credential_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
