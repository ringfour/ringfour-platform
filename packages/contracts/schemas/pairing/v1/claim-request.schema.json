{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/pairing/v1/claim-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z2-7-]{26,32}$"
    },
    "robot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "appearance": {
      "description": "Console visual identity only; independent of Agent profiles. Null uses the default robot icon. Images are PNG/JPEG/WebP base64 data URLs, at most 256 KiB decoded; signatures must match MIME type. No remote URLs or SVG.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 350000,
      "pattern": "^(bot|rover|arm|drone|base101|data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/]+={0,2})$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "robot_id": {}
      },
      "required": [
        "robot_id"
      ]
    },
    {
      "properties": {
        "name": {}
      },
      "required": [
        "name"
      ]
    }
  ]
}
