{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/identity/v1/organization-invitation.schema.json",
  "title": "OrganizationInvitation",
  "type": "object",
  "required": [
    "id",
    "organization_id",
    "email",
    "role",
    "created_at",
    "expires_at",
    "accepted_at",
    "accepted_by_user_id",
    "revoked_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "enum": [
        "owner",
        "developer",
        "operator"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "accepted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "accepted_by_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
