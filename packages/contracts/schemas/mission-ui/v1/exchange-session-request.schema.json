{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/mission-ui/v1/exchange-session-request.schema.json",
  "title": "Mission UI bootstrap exchange",
  "type": "object",
  "required": ["session_id", "bootstrap_token"],
  "additionalProperties": false,
  "properties": {
    "session_id": {"type": "string", "format": "uuid"},
    "bootstrap_token": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
  }
}
