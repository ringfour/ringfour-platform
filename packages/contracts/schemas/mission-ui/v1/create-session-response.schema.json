{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/mission-ui/v1/create-session-response.schema.json",
  "title": "Mission UI bootstrap session",
  "type": "object",
  "required": ["session_id", "execution_id", "ui_origin", "bootstrap_token", "bootstrap_expires_at", "console_origin"],
  "additionalProperties": false,
  "properties": {
    "session_id": {"type": "string", "format": "uuid"},
    "execution_id": {"type": "string", "format": "uuid"},
    "ui_origin": {"type": "string", "format": "uri"},
    "bootstrap_token": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
    "bootstrap_expires_at": {"type": "string", "format": "date-time"},
    "console_origin": {"type": "string", "format": "uri"}
  }
}
