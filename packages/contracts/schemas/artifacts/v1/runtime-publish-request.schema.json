{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/artifacts/v1/runtime-publish-request.schema.json",
  "title": "Publish finalized mission artifact",
  "description": "New Ringfour design. The path is execution-relative and the runtime creates an immutable snapshot before acknowledging.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "path", "content_type"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"},
    "content_type": {"enum": ["image/jpeg", "image/png", "application/octet-stream"]}
  }
}
