{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.ringfour.dev/artifacts/v1/artifact.schema.json",
  "title": "Execution artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "path", "size", "sha256", "content_type", "state"],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"},
    "size": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_type": {"enum": ["image/jpeg", "image/png", "application/octet-stream"]},
    "state": {"enum": ["pending", "uploading", "available", "failed"]}
  }
}
