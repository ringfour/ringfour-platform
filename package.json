{
  "name": "ringfour-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Ringfour v0.1 — hosted robotics application platform. Monorepo root; orchestration scripts only, no dependencies. Each app and package has its own manifest and lockfile.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "lint": "bash scripts/lint.sh",
    "typecheck": "bash scripts/typecheck.sh",
    "test": "bash scripts/test-component.sh",
    "test:e2e": "bash tests/e2e/00-health.sh",
    "test:e2e:01": "bash tests/e2e/01-identity.sh",
    "test:e2e:02": "bash tests/e2e/02-enrollment.sh",
    "test:e2e:03": "bash tests/e2e/03-connectivity.sh",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml up -d --build",
    "compose:down": "docker compose -f infra/compose/docker-compose.yml down",
    "compose:clean": "docker compose -f infra/compose/docker-compose.yml down -v --remove-orphans",
    "compose:logs": "docker compose -f infra/compose/docker-compose.yml logs -f"
  }
}
