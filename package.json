{
  "name": "ringfour-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Ringfour v0.1 \u2014 hosted robotics application platform. Monorepo root; orchestration scripts only, no dependencies. Each app and package has its own manifest and lockfile.",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "lint": "bash scripts/lint.sh",
    "typecheck": "bash scripts/typecheck.sh",
    "test": "bash scripts/test-component.sh",
    "test:e2e": "bash tests/e2e/00-health.sh",
    "test:acceptance": "python3 scripts/apps-acceptance.py",
    "test:acceptance:runner": "python3 -m unittest discover -s tests/automation -v",
    "test:e2e:01": "bash tests/e2e/01-identity.sh",
    "test:e2e:02": "bash tests/e2e/02-enrollment.sh",
    "test:e2e:pairing": "bash tests/e2e/02-pairing.sh",
    "test:e2e:apps": "uv run --project apps/daemon python tests/e2e/ap10-runtime.py"
  }
}
