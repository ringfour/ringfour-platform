# Set a persistent password before first boot. Keep this file on the N100.
POSTGRES_PASSWORD=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.ringfour.eu
CONSOLE_ORIGIN=
API_PORT=8080
CONSOLE_PORT=5173

# Enable after configuring a registry reachable from the API and robots.
APPS_INSTALLATIONS_ENABLED=false

# Enable the authenticated managed App registry when signing files are ready.
RINGFOUR_MANAGED_REGISTRY=0
RINGFOUR_REGISTRY_HOST=repository.ringfour.eu
RINGFOUR_REGISTRY_TOKEN_REALM=https://api.ringfour.eu/registry/token
RINGFOUR_REGISTRY_PORT=5000
RINGFOUR_REGISTRY_CERT=
RINGFOUR_REGISTRY_KEY=
RINGFOUR_REGISTRY_HTTP_SECRET=
RINGFOUR_REGISTRY_PUBLISHED_QUOTA_BYTES=53687091200
RINGFOUR_REGISTRY_STORAGE=filesystem
