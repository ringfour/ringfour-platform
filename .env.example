# Ringfour local development defaults — dev-only values, no secrets.
# Copy to .env to override; .env is gitignored.

# PostgreSQL password for the local Compose stack only.
POSTGRES_PASSWORD=ringfour_dev

# Set RUNNER_AUTH_TOKEN in your shell or secret manager; do not commit its value.

# Hosted private storage: configure Storage__Backend=s3 and set
# Storage__S3__Endpoint, Storage__S3__Region and Storage__S3__Bucket in the
# deployment environment. Supply credentials through the AWS SDK provider chain.
# Local Compose uses a named filesystem volume instead.

# Host-side CLI defaults (services published by Compose).
RINGFOUR_API_URL=http://localhost:8080
RINGFOUR_DAEMON_URL=http://localhost:8081

# Host-side EF Core migration runs and local tooling (Compose services use the internal network instead).
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=ringfour;Username=ringfour;Password=ringfour_dev
